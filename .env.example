# Обычно этот файл писать руками не нужно: ./install.sh задаст вопросы и заполнит .env сам.
# Здесь — то же самое для тех, кто ставит вручную. Полный список переменных: docs/configuration.md

WIKI_PASSWORD=                 # пароль веб-интерфейсов (обязателен)
CLAUDE_MODEL=sonnet            # sonnet | opus | haiku | полный id модели
CLAUDE_CODE_OAUTH_TOKEN=       # токен от `claude setup-token`; пусто — берётся сессия из ~/.claude
TZ=Europe/Moscow               # по этой зоне срабатывают напоминания

TELEGRAM_BOT_TOKEN=            # токен у @BotFather; пусто — бот выключен
TELEGRAM_ALLOWED_IDS=          # список chat id через запятую; пусто — привязка по коду (./bender pair)

WIKI_PORT=8842
TASKS_PORT=8851
BOOKS_PORT=8899

BENDER_TAG=main                # main — готовые образы из GHCR, local — сборка из исходников
